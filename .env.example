# Security Dashboard - Environment Variables
# Copia questo file in .env e modifica i valori

# Database
# SQLite (default per sviluppo locale)
DATABASE_URL=sqlite:///data/security.db

# PostgreSQL (per produzione/Proxmox fase 2)
# DATABASE_URL=postgresql://user:password@db:5432/security_dashboard

# NVD API Key (richiesta su https://nvd.nist.gov/developers/request-an-api-key)
# Senza key: 5 req/30s | Con key: 50 req/30s
NVD_API_KEY=

# Rate limit NVD (auto-configurato in base alla presenza della key)
# NVD_RATE_LIMIT=50  # con key
# NVD_RATE_LIMIT=5   # senza key

# Application
LOG_LEVEL=INFO
SECRET_KEY=dev-secret-change-in-production-min-32-chars
TZ=Europe/Rome

# Paths (già configurati nel container)
# DATA_DIR=/app/data
# LOGS_DIR=/app/logs
# CONFIG_DIR=/app/config

# FeedHub import directory
# FEEDHUB_IMPORT_DIR=/app/data/feedhub_imports

# Perimetro import directory
# PERIMETRO_IMPORT_DIR=/app/data/perimetro_imports

# Syslog import directory
# SYSLOG_IMPORT_DIR=/app/data/syslog_imports

# Scheduler intervals (ore)
# NVD_SYNC_INTERVAL_HOURS=6
# FEED_SYNC_INTERVAL_HOURS=1